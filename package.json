{
  "name": "little-potli",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "dev:sandbox": "wrangler dev --ip 0.0.0.0 --port 3000",
    "db:migrate:local": "wrangler d1 migrations apply little-potli-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply little-potli-production --remote",
    "db:seed": "wrangler d1 execute little-potli-production --local --file=./seed.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local && npm run db:seed"
  },
  "dependencies": {
    "hono": "^4.12.26"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.25.2",
    "vite": "^6.3.5",
    "wrangler": "^4.4.0"
  }
}
